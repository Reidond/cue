<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cue for Windows: WinUI 3, unpackaged, with the .NET and Windows App SDK runtimes in the folder next to Cue.exe, so the MSI needs no runtime installer.
       Build it with scripts/build.ps1 (it publishes for an architecture and makes the MSI); a plain `dotnet build` works too. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Cue</RootNamespace>
    <AssemblyName>Cue</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>Cue</Product>
    <Description>Cue: a prompter and call notetaker</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The Windows App SDK ships every language's resources: only English is used. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The backend's address, stamped by scripts/build.ps1 from apps/api/production-url.txt (CUE_API_URL still overrides it at run time);
         a build without it talks to `cf dev`, as the Mac's binary outside its bundle does. -->
    <CueApiUrl Condition="'$(CueApiUrl)' == ''">http://127.0.0.1:5173</CueApiUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CueApiUrl</_Parameter1>
      <_Parameter2>$(CueApiUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- The repository whose GitHub releases a release build updates itself from (OWNER/NAME, scripts/build.ps1 stamps CUE_UPDATES): without it Cue doesn't look for updates. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(CueUpdates)' != ''">
      <_Parameter1>CueUpdates</_Parameter1>
      <_Parameter2>$(CueUpdates)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The words of a language an answer's "numbers" and "source" lines start with: the Mac's data, shared. -->
    <Content Include="..\..\mac\Resources\lexicons\*.json" Link="Resources\lexicons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
