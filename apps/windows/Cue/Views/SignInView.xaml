<UserControl
    x:Class="Cue.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460" Padding="32">
        <FontIcon Glyph="&#xE77B;" FontSize="52" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Text="Sign in to Cue" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock
            Text="Cue is invite-only. Sign in with the Google or GitHub account your invitation went to."
            TextWrapping="Wrap"
            TextAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
        <StackPanel x:Name="ProgressRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
            <ProgressRing Width="16" Height="16" IsActive="True" />
            <TextBlock x:Name="ProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="24,8" Click="OnSignIn" />
        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnCancel" />
        <TextBlock
            Text="Cue's servers do the listening, answering and note-taking, so a call's audio, transcript and notes are processed and kept there, not only on this PC."
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
