<Page
    x:Class="Cue.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="OverviewTab" Text="Overview" />
                <SelectorBarItem x:Name="AnswersTab" Text="Prepared Answers" />
                <SelectorBarItem x:Name="NotesTab" Text="Notes" />
            </SelectorBar>
            <Border x:Name="TabHost" />
        </StackPanel>
    </ScrollViewer>
</Page>
