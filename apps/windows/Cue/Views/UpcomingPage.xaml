<Page
    x:Class="Cue.UpcomingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="SignInHost" />
        <ScrollViewer x:Name="SignedIn" Visibility="Collapsed">
            <StackPanel Padding="36,24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Upcoming" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="The calls in your calendar will be here, to record into a project, as Cue for Windows gets them."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
