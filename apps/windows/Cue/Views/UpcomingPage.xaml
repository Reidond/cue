<Page
    x:Class="Cue.UpcomingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="SignInHost" />
        <ScrollViewer x:Name="SignedIn" Visibility="Collapsed">
            <StackPanel Padding="36,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Upcoming" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel x:Name="Body" Spacing="16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
