<Project Sdk="WixToolset.Sdk/6.0.2">

  <!-- The installer of Cue for Windows: Cue-VERSION-ARCH.msi, per machine, into Program Files\Cue. scripts/build.ps1 builds it from the published app
       (apps\windows\build\ARCH\) with `dotnet build`: no Visual Studio. WiX 6 is the newest that asks nothing of whoever builds: WiX 7 needs its
       Open Source Maintenance Fee EULA accepted by its user (`AcceptEula`), which is the owner's decision. -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <InstallerPlatform>$(Platform)</InstallerPlatform>
    <CueVersion Condition="'$(CueVersion)' == ''">$(Version)</CueVersion>
    <OutputName>Cue-$(CueVersion)-$(Platform)</OutputName>
    <!-- The validation's guidelines the installer doesn't follow on purpose: ICE03, the Windows App SDK's DLLs carry language ids Windows Installer's table
         can't hold (the files are as they were published); ICE43 and ICE57, the Start menu shortcut is the file's own and goes with it, with no per-user
         registry value to hold it, and there is none to keep: Cue writes nothing to the registry. -->
    <SuppressIces>ICE03;ICE43;ICE57</SuppressIces>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\build\$(Platform)\</AppDir>
    <DefineConstants>$(DefineConstants);CueVersion=$(CueVersion);AppDir=$(AppDir.TrimEnd('\'));IconFile=$(MSBuildThisFileDirectory)..\Cue\Assets\AppIcon.ico</DefineConstants>
  </PropertyGroup>

</Project>
